# 개인 Apple Developer 계정 전환용 설정. 미정인 값은 비워 둔다.
# .env.local에 복사한 뒤 새 값만 입력한다. EXPO_PUBLIC_ 값은 앱에 포함된다.
APP_VARIANT=development

# 개인 계정의 Team ID와 등록된 production 기준 Bundle ID.
# development에는 .dev가 자동으로 붙는다.
APPLE_TEAM_ID=Q4KAG5GU2Y
IOS_BUNDLE_IDENTIFIER=com.gogo.baton

# 새 서버 주소에 /api/v1까지 포함한다. 서버 배포 전에는 비워 둔다.
EXPO_PUBLIC_API_URL=

# 새 Kakao 앱의 Native app key. 서버 Admin key와 같은 Kakao 앱 소속이어야 한다.
KAKAO_NATIVE_APP_KEY=

# 기존 EAS 조직 공통 분석 설정. 분석 프로젝트 변경 여부는 별도 결정한다.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
