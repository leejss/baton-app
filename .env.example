# 환경변수 템플릿. 이 파일만 git에 올라가고 실제 값이 든 .env* 는 올라가지 않습니다.
# 복사해서 쓰십시오:  cp .env.example .env.development
#
# EXPO_PUBLIC_ 접두사가 붙은 값은 앱 번들에 그대로 포함됩니다. 비밀값을 넣지 마십시오.

EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# 백엔드 API 의 base URL. 계약의 `/api/v1` 까지 **경로를 포함한 전체 주소**를 넣습니다.
#
#   O  https://dev-api.example.com/api/v1
#   X  https://dev-api.example.com           /api/v1 이 빠져 모든 요청이 404 가 됩니다
#
# 호스트는 AWS Lightsail Container Service 의 기본 HTTPS 주소입니다(ADR-021).
# 값을 모르면 백엔드 담당자에게 "dev Lightsail 기본 HTTPS 주소"를 요청하십시오.
# 경로 `/api/v1` 의 근거는 wiki `openapi.yaml` 의 servers 입니다.
#
# ⚠️ 비워두면 개발용 목(auth.mock.ts)으로 동작합니다. 값을 넣는 순간 목이 꺼지므로
#    서버가 실제로 응답하지 않으면 로그인·비밀번호 재설정 화면이 전부 실패합니다.
EXPO_PUBLIC_API_URL=

# 카카오 네이티브 앱 키 (developers.kakao.com > 내 애플리케이션 > 앱 키).
# 빌드 시점에만 쓰입니다(app.config.ts). 네이티브 프로젝트에 박히는 값이라 비밀값이 아닙니다.
# development 빌드에서는 없어도 되지만, 그 경우 카카오 로그인이 동작하지 않습니다.
# preview/production 빌드에서는 없으면 빌드가 실패합니다.
KAKAO_NATIVE_APP_KEY=

# ── 개발용 목(mock) ────────────────────────────────────────────────
# 백엔드 인프라가 아직 배포되지 않아 auth 관련 요청을 가짜 서버로 처리합니다.
# EXPO_PUBLIC_API_URL 이 비어 있으면 자동으로 켜지므로 보통은 건드릴 필요가 없습니다.
#
# 목이 켜진 동안:
#   이메일 로그인 성공  test@baton.dev  (비밀번호는 형식만 맞으면 통과)
#   그 외 이메일        실패 → 5회째부터 5분 잠금
#   인증코드            123456
#   카카오              SDK 로그인은 진짜로 동작하고, 서버 교환만 목입니다
#
# 주소가 생긴 뒤에도 목을 계속 쓰려면 true 로 둡니다.
EXPO_PUBLIC_USE_MOCK_AUTH=

# 소셜 로그인 목의 응답을 고릅니다. 계약이 두 갈래라 둘 다 눌러봐야 합니다.
#   (비움)          기존 계정 로그인 (LOGGED_IN)
#   signupRequired  신규 소셜 계정 → 가입 대기 (SIGNUP_REQUIRED)
EXPO_PUBLIC_MOCK_SOCIAL_OUTCOME=
